<UserControl x:Class="Proofly.Views.ConfirmOverlay"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Focusable="True" FocusVisualStyle="{x:Null}" PreviewKeyDown="Confirm_PreviewKeyDown">
    <Grid Background="{DynamicResource Backdrop}" MouseLeftButtonDown="Backdrop_MouseDown">
        <Border MaxWidth="420" Padding="20" HorizontalAlignment="Center" VerticalAlignment="Center"
                CornerRadius="12" BorderThickness="1" Background="{DynamicResource Panel}"
                BorderBrush="{DynamicResource LineStrong}" MouseLeftButtonDown="Card_MouseDown">
            <StackPanel>
                <TextBlock x:Name="TitleText" Margin="0,0,0,8" FontSize="15" FontWeight="SemiBold"
                           Foreground="{DynamicResource Text}" />
                <TextBlock x:Name="MessageText" Margin="0,0,0,16" FontSize="13" LineHeight="21"
                           TextWrapping="Wrap" Foreground="{DynamicResource Muted}" />
                <TextBox x:Name="InputBox" MinWidth="320" Height="34" Margin="0,0,0,16" MaxLength="80"
                         Visibility="Collapsed" />
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                    <Button x:Name="FirstButton" Click="First_Click" />
                    <Button x:Name="SecondButton" Margin="8,0,0,0" Click="Second_Click" />
                    <Button x:Name="CancelButton" Margin="8,0,0,0" Content="Cancel" Click="Cancel_Click" />
                </StackPanel>
            </StackPanel>
        </Border>
    </Grid>
</UserControl>
