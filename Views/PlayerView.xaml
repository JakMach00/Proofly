<UserControl x:Class="Proofly.Views.PlayerView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Focusable="True" FocusVisualStyle="{x:Null}" Background="{DynamicResource Bg}"
             PreviewKeyDown="Player_PreviewKeyDown">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <Border Grid.Row="0" Padding="14,9" Background="{DynamicResource Panel}"
                BorderBrush="{DynamicResource Line}" BorderThickness="0,0,0,1">
            <DockPanel LastChildFill="False">
                <TextBlock x:Name="TitleText" DockPanel.Dock="Left" Style="{StaticResource MonoText}" />
                <Button DockPanel.Dock="Right" Focusable="False" Style="{StaticResource PrimaryButton}"
                        Content="Close" Click="Close_Click" />
            </DockPanel>
        </Border>

        <Grid Grid.Row="1" Background="{DynamicResource CanvasBg}">
            <MediaElement x:Name="Media" Margin="14" Stretch="Uniform" LoadedBehavior="Manual"
                          UnloadedBehavior="Manual" ScrubbingEnabled="True" MediaOpened="Media_Opened"
                          MediaEnded="Media_Ended" MediaFailed="Media_Failed" />
            <TextBlock x:Name="ErrorText" MaxWidth="520" HorizontalAlignment="Center" VerticalAlignment="Center"
                       FontSize="13" TextAlignment="Center" TextWrapping="Wrap"
                       Foreground="{DynamicResource Warn}" Visibility="Collapsed" />
        </Grid>

        <Border Grid.Row="2" Padding="14,10" Background="{DynamicResource Panel}"
                BorderBrush="{DynamicResource Line}" BorderThickness="0,1,0,0">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <Button x:Name="PlayButton" Grid.Column="0" MinWidth="72" Focusable="False" Content="Pause"
                        Click="Play_Click" />
                <TextBlock x:Name="TimeText" Grid.Column="1" Margin="12,0" Style="{StaticResource MonoText}"
                           Text="00:00 / 00:00" />
                <Slider x:Name="SeekSlider" Grid.Column="2" VerticalAlignment="Center" Minimum="0" Maximum="1"
                        IsMoveToPointEnabled="True" ValueChanged="Seek_ValueChanged"
                        Thumb.DragStarted="Seek_DragStarted" Thumb.DragCompleted="Seek_DragCompleted" />
                <StackPanel x:Name="SpeedRow" Grid.Column="3" Margin="14,0,0,0" Orientation="Horizontal">
                    <TextBlock Margin="0,0,8,0" VerticalAlignment="Center" FontSize="12"
                               Foreground="{DynamicResource Muted}" Text="Speed" />
                    <RadioButton GroupName="PlayerSpeed" Style="{StaticResource ToolButton}" Margin="0,0,6,0"
                                 Tag="1" Content="1x" IsChecked="True" Click="Speed_Click" />
                    <RadioButton GroupName="PlayerSpeed" Style="{StaticResource ToolButton}" Margin="0,0,6,0"
                                 Tag="1.1" Content="1.1x" Click="Speed_Click" />
                    <RadioButton GroupName="PlayerSpeed" Style="{StaticResource ToolButton}" Margin="0,0,6,0"
                                 Tag="1.25" Content="1.25x" Click="Speed_Click" />
                    <RadioButton GroupName="PlayerSpeed" Style="{StaticResource ToolButton}" Margin="0,0,6,0"
                                 Tag="1.5" Content="1.5x" Click="Speed_Click" />
                    <RadioButton GroupName="PlayerSpeed" Style="{StaticResource ToolButton}" Margin="0,0,6,0"
                                 Tag="1.75" Content="1.75x" Click="Speed_Click" />
                    <RadioButton GroupName="PlayerSpeed" Style="{StaticResource ToolButton}" Tag="2" Content="2x"
                                 Click="Speed_Click" />
                </StackPanel>
                <CheckBox x:Name="MuteCheck" Grid.Column="4" Margin="16,0,0,0" VerticalAlignment="Center"
                          Focusable="False" Content="Mute" Click="Mute_Click" />
            </Grid>
        </Border>
    </Grid>
</UserControl>
